# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Direct Connection (for migrations)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Configuration (Supabase SMTP or custom)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@wdwshiftx.com

# Rate Limiting (Upstash Redis - optional)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Error Tracking (Sentry - optional)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Timezone (for server-side operations)
TZ=America/New_York

# Node Environment
NODE_ENV=development

# Cron Job Secret (generate a strong random string)
# Used to secure the /api/cron/* endpoints and to sign digest unsubscribe links
CRON_SECRET=your-cron-secret-here

# Registration gate — fail-closed: sign-ups are PAUSED unless this is set to 1.
# Set in .env.local and Vercel Preview (dev branch); leave unset on Production
# until launch, then add it there to reopen sign-ups with no code change.
NEXT_PUBLIC_REGISTRATION_OPEN=1

# Google AdSense (Task 12) — publisher ID + one env var per ad placement.
# A placement without a slot ID renders the "Advertisement" placeholder.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_STICKY_DESKTOP=your-sticky-desktop-slot-id-here
NEXT_PUBLIC_ADSENSE_SLOT_STICKY_MOBILE=your-sticky-mobile-slot-id-here